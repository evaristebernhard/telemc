TITLE = 'B2 GAIA INITIAL BED EROSION'

GEOMETRY FILE = 'b2_geometry.slf'
BOUNDARY CONDITIONS FILE = 'b2_boundary.cli'
RESULTS FILE = 'b2_physical_gaia_600s.slf'

MASS-BALANCE = YES

VARIABLES FOR GRAPHIC PRINTOUTS = 'B,E,H,TOB,M'

CLASSES TYPE OF SEDIMENT = 'NCO'
CLASSES SEDIMENT DIAMETERS = 0.00086
CLASSES SEDIMENT DENSITY = 2650.0

LAYERS NON COHESIVE BED POROSITY = 0.40

NUMBER OF LAYERS FOR INITIAL STRATIFICATION = 1

BED LOAD FOR ALL SANDS = YES
SUSPENSION FOR ALL SANDS = NO

BED-LOAD TRANSPORT FORMULA FOR ALL SANDS = 1

MINIMUM DEPTH FOR BEDLOAD = 0.003

SLOPE EFFECT = NO
SEDIMENT SLIDE = 0
